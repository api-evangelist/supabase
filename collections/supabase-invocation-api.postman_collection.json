{
  "info": {
    "_postman_id": "f831e172-a0df-4f99-abf2-6bb94fbb072b",
    "name": "Supabase Edge Functions Invocation API",
    "description": "Supabase Edge Functions are globally distributed, server-side TypeScript functions powered by the Deno runtime. They are invoked via HTTP requests to a project-specific URL. Edge Functions can access the Supabase client libraries for interacting with the database, auth, and storage services. By default, they require a valid JWT in the authorization header, but this can be disabled per function. This specification documents the HTTP invocation interface for deployed Edge Functions.\n\nContact Support:\n Name: Supabase Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T20:48:19.000Z",
    "updatedAt": "2026-10-21T20:48:19.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-f831e172-a0df-4f99-abf2-6bb94fbb072b"
  },
