        {
          "name": "Invoke an Edge Function via GET",
          "id": "e004016d-c538-4767-acf4-9a482bcaabc4",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/:function_slug",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ":function_slug"
              ],
              "variable": [
                {
                  "id": "c3f9a645-d483-4284-ad14-36dd12e3da22",
                  "key": "function_slug",
                  "value": "<string>",
                  "description": "(Required) The URL-friendly slug of the deployed Edge Function to invoke."
                }
              ]
            },
            "description": "Invokes a deployed Edge Function using an HTTP GET request. The function can read query parameters and headers from the request. Authorization is required by default unless JWT verification is disabled for the function."
