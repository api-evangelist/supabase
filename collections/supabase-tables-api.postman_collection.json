      "name": "Tables",
      "description": {
        "content": "CRUD operations on database tables. Paths are auto-generated based on your database schema.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c12dbdb6-596b-43e8-b342-6229c46f9a8e",
          "name": "Select rows from a table",
          "request": {
            "name": "Select rows from a table",
            "description": {
              "content": "Retrieves rows from a database table with support for filtering, sorting, pagination, and column selection. PostgREST operators are used in query parameters for horizontal filtering (e.g. eq, neq, gt, lt, gte, lte, like, ilike, in, is, fts, plfts, phfts, wfts, cs, cd, ov, sl, sr, nxl, nxr, adj, not, or, and). Vertical filtering uses the select parameter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":table"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "select",
                  "value": "<string>",
                  "description": "Comma-separated list of columns to return. Supports renaming (alias:column), casting (column::type), and embedding related resources via foreign keys (related_table(columns))."
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "<string>",
                  "description": "Comma-separated list of columns to sort by. Append .desc for descending, .asc for ascending. Use .nullsfirst or .nullslast to control null ordering."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of rows to return"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Number of rows to skip before starting to return rows"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "table",
                  "description": "(Required) Name of the database table or view"
                },
                {
                  "description": "Your Supabase project reference ID",
                  "type": "any",
                  "value": "{{project_ref}}",
                  "key": "project_ref"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "Request a specific range of rows using HTTP Range header (e.g. 0-24 for first 25 rows).",
                "key": "Range",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Request a total row count. Use count=exact for precise count, count=planned for estimated count, or count=estimated for a combination.",
                "key": "Prefer",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
