                  "disabled": false,
                  "key": "provider",
                  "value": "<string>",
                  "description": "(Required) The OAuth provider to authenticate with"
                },
                {
                  "disabled": false,
                  "key": "redirect_to",
                  "value": "<uri>",
                  "description": "URL to redirect to after authentication"
                },
                {
                  "disabled": false,
                  "key": "scopes",
