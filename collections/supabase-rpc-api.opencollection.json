{
  "opencollection": "1.0.0",
  "info": {
    "name": "Supabase Auth Admin RPC API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "RPC",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Invoke a PostgreSQL function",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{project_ref}.supabase.co/auth/v1/rpc/:function_name",
            "params": [
              {
                "name": "function_name",
                "value": "",
                "type": "path",
                "description": "Name of the PostgreSQL function to invoke"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Calls a PostgreSQL function (stored procedure) via a remote procedure call. Function arguments are passed in the request body. Functions must be created in the public schema or an exposed schema."
        }
      ]
    }
  ],
  "bundled": true
}