{
  "opencollection": "1.0.0",
  "info": {
    "name": "Supabase Auth Admin API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Admin",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all users (admin)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{project_ref}.supabase.co/auth/v1/admin/users",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of users per page"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a paginated list of all users in the project. Requires service_role key authentication."
        },
        {
          "info": {
            "name": "Create a user (admin)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{project_ref}.supabase.co/auth/v1/admin/users",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new user without requiring email confirmation. Requires service_role key authentication."
        },
        {
          "info": {
            "name": "Get a user by ID (admin)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{project_ref}.supabase.co/auth/v1/admin/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "UUID of the user"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves a specific user by their UUID. Requires service_role key authentication."
        },
        {
          "info": {
            "name": "Update a user (admin)",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{project_ref}.supabase.co/auth/v1/admin/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "UUID of the user"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates a user's profile, role, or confirmation status. Requires service_role key authentication."
        },
        {
          "info": {
            "name": "Delete a user (admin)",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{project_ref}.supabase.co/auth/v1/admin/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "UUID of the user"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Permanently deletes a user and their associated data. Requires service_role key authentication."
        },
        {
          "info": {
            "name": "Invite a user by email",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{project_ref}.supabase.co/auth/v1/invite",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Sends an invitation email to the specified address. The recipient can use the link in the email to create their account. Requires service_role key authentication."
        }
      ]
    }
  ],
  "bundled": true
}