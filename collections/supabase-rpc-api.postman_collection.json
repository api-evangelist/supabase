          "name": "Invoke a PostgreSQL function",
          "request": {
            "name": "Invoke a PostgreSQL function",
            "description": {
              "content": "Calls a PostgreSQL function (stored procedure) via a remote procedure call. Function arguments are passed in the request body. Functions must be created in the public schema or an exposed schema.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rpc",
                ":function_name"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "function_name",
                  "description": "(Required) Name of the PostgreSQL function to invoke"
                },
                {
                  "description": "Your Supabase project reference ID",
                  "type": "any",
                  "value": "{{project_ref}}",
                  "key": "project_ref"
                }
              ]
            },
